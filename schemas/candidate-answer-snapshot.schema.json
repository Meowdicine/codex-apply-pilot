{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Meowdicine/codex-apply-pilot/schemas/candidate-answer-snapshot.schema.json",
  "title": "Apply Pilot candidate answer snapshot",
  "type": "object",
  "required": ["schemaVersion", "snapshotType", "applicationId", "candidateId", "candidateIdentitySha256", "officialUrlSha256", "createdAt", "readyForStaging", "unresolved", "questions", "answerSnapshotSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotType": { "const": "candidate-answer-snapshot" },
    "applicationId": { "type": "string", "minLength": 8 },
    "candidateId": { "$ref": "#/$defs/sha256" },
    "candidateIdentitySha256": { "$ref": "#/$defs/sha256" },
    "officialUrlSha256": { "$ref": "#/$defs/sha256" },
    "sourceAnswersSchemaVersion": { "type": ["integer", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "readyForStaging": { "type": "boolean" },
    "unresolved": { "type": "array", "items": { "type": "object" } },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["portalQuestionId", "prompt", "promptSha256", "semanticKey", "decision", "reviewedBy", "reviewedAt", "answer"],
        "properties": {
          "portalQuestionId": { "type": ["string", "null"] },
          "prompt": { "type": "string", "minLength": 1 },
          "promptSha256": { "$ref": "#/$defs/sha256" },
          "semanticKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "decision": { "enum": ["use-stored-answer", "candidate-confirmed", "prefer-not-to-answer", "not-applicable", "ask-user", "blocked-unsupported-fact"] },
          "reviewedBy": { "enum": ["user", "policy", "codex"] },
          "reviewedAt": { "type": "string", "format": "date-time" },
          "answer": { "type": ["object", "null"] }
        },
        "additionalProperties": false
      }
    },
    "answerSnapshotSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
  "additionalProperties": false
}
