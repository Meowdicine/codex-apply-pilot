{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Meowdicine/codex-apply-pilot/schemas/answers.schema.json",
  "title": "Apply Pilot answers",
  "type": "object",
  "required": ["schemaVersion", "answers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["questionId", "value", "source", "sensitivity", "automationPolicy", "verifiedAt"],
        "properties": {
          "questionId": { "type": "string", "minLength": 3 },
          "value": {},
          "source": {
            "enum": ["user-explicit", "verified-document", "approved-resume", "deterministic-normalization", "prefer-not-to-answer"]
          },
          "sensitivity": {
            "enum": ["ordinary", "personal", "protected", "legal-material"]
          },
          "automationPolicy": {
            "enum": ["auto-fill", "ask-each-time", "ask-until-verified", "never-store"]
          },
          "verifiedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
