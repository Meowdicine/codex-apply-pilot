          "id": "legal.security-clearance",
          "prompt": "你当前持有何种 security clearance？没有则填写 none。",
          "valueType": "string",
          "sensitivity": "legal-material",
          "requiredFor": [],
          "automationPolicy": "ask-until-verified",
          "inferenceAllowed": false
